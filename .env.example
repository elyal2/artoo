# Copy to .env.local and fill secrets

# Demo profile: which demo data to load (hotel, ecommerce, or custom)
# Place your demo files in demos/<profile>/init.sh and demos/<profile>/seed.py
DEMO_PROFILE=hotel
LLM_PROVIDER=bedrock
LLM_MODEL=eu.amazon.nova-lite-v1:0
LLM_CHART_MODEL=eu.anthropic.claude-sonnet-4-20250514
LLM_API_KEY=
LLM_AWS_PROFILE=
LLM_AWS_REGION=eu-south-2
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# PostgreSQL (shared with OpenMetadata compose)
# IMPORTANT: change ARTOO_DB_PASSWORD in .env.local — must match postgres/init.sql
ARTOO_DB_PASSWORD=<change-me>
POSTGRES_SUPERUSER_PASSWORD=<change-me>
POSTGRES_DSN=postgresql://artoo_demo:<change-me>@postgresql:5432/artoo_demo

# OpenMetadata
OPENMETADATA_URL=http://openmetadata-server:8585
OPENMETADATA_API_TOKEN=
# Optional: scope the enricher to a specific database FQN prefix (e.g. my-service.my_db).
# Leave empty to process all tables discovered by OpenMetadata.
OPENMETADATA_DB_FILTER=

# API
API_PORT=8000
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=100

# Enricher
SAMPLE_ROWS=5
ENRICHMENT_CONCURRENCY=3

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json

# Airflow (OpenMetadata default compose)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=<change-me>
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=<change-me>
AIRFLOW_DB=airflow_db

# Superset bootstrap admin
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=<change-me>
SUPERSET_ADMIN_EMAIL=admin@example.com

# Superset
SUPERSET_DATABASE_URI=postgresql://artoo_demo:<change-me>@postgresql:5432/superset